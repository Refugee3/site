DATA_DIR=./data                       # SQLite + PDFs (gitignored)
APP_URL=                              # public origin, e.g. https://grader.school.org (share links, origin check, cookie secure=auto)
ANTHROPIC_API_KEY=                    # optional: a key saved on /teacher/settings takes precedence
APP_SECRET=                           # 32+ random chars (openssl rand -base64 32); encrypts the saved API key. Empty → DATA_DIR/secret.key is generated
MAX_SCAN_MB=100                       # 1..200: one whole-class scan (the reverse proxy must allow it)
MAX_SCAN_PAGES=200                    # 1..500
ANTHROPIC_EFFORT=high                 # low|medium|high|xhigh|max (medium is cheaper/faster)
AI_MODE=claude                        # claude | fake (deterministic demo; refused in production unless ALLOW_FAKE_AI=1)
ALLOW_FAKE_AI=0
AI_FALLBACKS=on                       # on|off; on → betas server-side-fallback-2026-07-01 + fallbacks:"default"
AI_CACHE_TTL=1h                       # 1h | 5m
AI_TIMEOUT_MS=600000                  # SDK timeout = wait for response headers (streams); wall clock is capped per job at 45 min
GRADING_CONCURRENCY=3
JOB_MAX_ATTEMPTS=4
TEACHER_SIGNUP_CODE=                  # if set (random, 12+ chars), required for every signup including the first; empty = only the first account may sign up
COOKIE_SECURE=auto                    # auto|true|false
ALLOWED_ORIGINS=                      # comma list of hosts; only if a proxy rewrites Host (read by next.config.ts)
MAX_UPLOAD_MB=20                      # 1..22 (PDFs are sent base64-encoded; 22 MiB keeps a request under the 32 MB API limit)
MAX_PAGES=40                          # 1..200
AGENT_BUDGET_GRADE_USD=2.00           # hosted agent: spending cap per paper (list prices); doubled on the one retry after a session hits it
AGENT_BUDGET_EXTRACT_USD=3.00         # hosted agent: cap per answer-key reading
AGENT_BUDGET_SCAN_USD=1.50            # hosted agent: cap per batch of up to 20 scanned pages
AGENT_SESSION_TIMEOUT_MS=1200000      # hosted agent: wall clock per session (60000..2700000); the job's own limit is 45 min
AGENT_KEEP_SESSIONS=0                 # 1 = keep agent sessions and uploads for debugging in the Console (never with real student work)
